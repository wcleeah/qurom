{
  "maxRounds": 10,
  "maxRebuttalTurnsPerFinding": 2,
  "maxConcurrentRuns": 1,
  "recursionLimit": 80,
  "requireUnanimousApproval": true,
  "researchTools": {
    "prefer": ["context7", "exa", "grepapp"],
    "webSearchProvider": "exa"
  },
  "designQuorum": {
    "enabled": true
  },
  "readerDiscovery": {
    "maxTurns": 6,
    "enabled": true
  },
  "tagging": {
    "enabled": true,
    "maxArticleTags": 8,
    "maxNoteTags": 8,
    "predefinedTags": []
  }
}
